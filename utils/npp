#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "$0")"
SCRIPT_NAME="$(basename "$SELF")"
INSTALL_DIR="$HOME/bin"
INSTALL_PATH="$INSTALL_DIR/$SCRIPT_NAME"

die() { echo "ERROR: $*" >&2; exit 1; }

find_npp() {
    # Prefer Notepad++ installed per-user or system-wide
    for p in \
	    $(cat /proc/registry/HKEY_CLASSES_ROOT/Applications/notepad++.exe/shell/open/command/\@ | sed 's|\\|\/|g; s|c:|/c|i; s|\("[^"]*"\).*|\1|') \
        "$LOCALAPPDATA/Notepad++/notepad++.exe" \
        "/c/Program Files/Notepad++/notepad++.exe" \
        "/c/Program Files (x86)/Notepad++/notepad++.exe"
    do
        [ -x "$p" ] && { echo "$p"; return 0; }
    done
    return 1
}

install_self() {
    mkdir -p "$INSTALL_DIR"

    # If already exists, check content or symlink target
    if [ -e "$INSTALL_PATH" ] || [ -L "$INSTALL_PATH" ]; then
        echo "Existing installation detected: $INSTALL_PATH"

        if [ -L "$INSTALL_PATH" ]; then
            target="$(readlink -f "$INSTALL_PATH")"
            if [ "$target" = "$SELF" ]; then
                echo "Already installed and identical (symlink)."
                exit 0
            else
                [ "${FORCE:-0}" = "1" ] || die "Different symlink target: $target (use --force)"
            fi
        else
            # Compare with hash if file
            existing_hash="$(sha256sum "$INSTALL_PATH" | awk '{print $1}')"
            my_hash="$(sha256sum "$SELF" | awk '{print $1}')"
            if [ "$existing_hash" = "$my_hash" ]; then
                echo "Already installed and identical (file)."
                exit 0
            else
                [ "${FORCE:-0}" = "1" ] || die \
                    "Existing file differs from this version (use --force to replace)"
            fi
        fi

        echo "Overwriting due to --force"
        rm -f "$INSTALL_PATH"
    fi

    ln -s "$SELF" "$INSTALL_PATH"
    echo "Installed $SCRIPT_NAME → $INSTALL_PATH"
}

main() {
    case "${1:-}" in
        --install)
            install_self
            exit 0
            ;;
        --force)
            FORCE=1
            shift
            [ "${1:-}" = "--install" ] || die "--force only allowed with --install"
            install_self
            exit 0
            ;;
    esac

    npp_path="$(find_npp)" || die "Notepad++ not found"
    exec "$npp_path" "$@"
}

main "$@"

